  'MemoryPool.cpp',
  'ScriptAnalyzer.cpp',
  'ScriptTokenCache.cpp',
  'Serialization.cpp',
  'StringVar.cpp',
  'ThreadLocal.cpp',
)

nvse_args = common_args + [
  '-D_CRT_SECURE_NO_WARNINGS',
  '-D_USRDLL',
  '-DNVSE_EXPORTS',
  '-DNVSE_CORE',
  '/FInvse/prefix.h',
]

# Release|Win32: the game runtime.
nvse_dll = shared_library(
  'nvse_1_4',
  nvse_shared_sources + nvse_runtime_sources,
  name_prefix: '',
  include_directories: inc,
  cpp_args: nvse_args + ['-DRUNTIME', '-DRUNTIME_VERSION=0x040020D0'],
  link_with: [common_lib, loader_common_lib],
  link_args: ['/DYNAMICBASE:NO', '/MAP'],
  vs_module_defs: 'exports.def',
  install: true,
  install_dir: install_root,
)

# Release CS|Win32: the GECK.
shared_library(
  'nvse_editor_1_4',
  nvse_shared_sources,
  name_prefix: '',
  include_directories: inc,
  cpp_args: nvse_args + ['-DEDITOR', '-DEDITOR_VERSION=0x04002060'],
  link_with: [common_lib, loader_common_lib],
  link_args: ['/DYNAMICBASE:NO'],
  vs_module_defs: 'exports.def',
  install: true,
  install_dir: install_root,
)

# Shipped with the release archive; not produced by any project in the solution.
install_data('nvse_config.ini', install_dir: install_root / 'Data' / 'NVSE')
