# Excluded from the Release CS configuration.
nvse_runtime_sources = files(
  'ArrayVar.cpp',
  'commands_Algohol.cpp',
  'Commands_Array.cpp',
  'Commands_Console.cpp',
  'Commands_Factions.cpp',
  'Commands_Game.cpp',
  'Commands_Input.cpp',
  'Commands_Inventory.cpp',
  'Commands_InventoryRef.cpp',
  'Commands_List.cpp',
  'Commands_Math.cpp',
  'Commands_Misc.cpp',
  'Commands_MiscRef.cpp',
  'Commands_NetImmerse.cpp',
  'Commands_Packages.cpp',
  'Commands_Script.cpp',
  'Commands_String.cpp',
  'Commands_UI.cpp',
  'Core_Serialization.cpp',
  'EventManager.cpp',
  'FunctionScripts.cpp',
  'GameBSExtraData.cpp',
  'GameExtraData.cpp',
  'GameObjects.cpp',
  'GameOSDepend.cpp',
  'GameProcess.cpp',
  'GameSettings.cpp',
  'GameTasks.cpp',
  'GameTiles.cpp',
  'GameUI.cpp',
  'Hooks_Animation.cpp',
  'Hooks_CreatedObject.cpp',
